DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=news.djangify.com,www.news.djangify.com
CSRF_TRUSTED_ORIGINS=https://news.djangify.com,https://www.news.djangify.com
# Optional: Redis cache (otherwise in-process memory is used)
# REDIS_URL=redis://127.0.0.1:6379/1
# Long random string; the Claude connector sends it to /mcp/
MCP_TOKEN=

# Daily digest email (manage.py send_daily_digest). Leave EMAIL_HOST empty to print
# the email in the terminal instead of sending it.
SITE_URL=https://news.djangify.com
DIGEST_RECIPIENTS=you@example.com
DEFAULT_FROM_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
